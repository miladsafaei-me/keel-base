<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen: the product's emblem on its stage colour, until the app has drawn. -->
    <style name="Theme.Signal.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/stage</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.Signal</item>
    </style>

    <!-- The app: no action bar, drawn edge to edge; the web shell paints every bar. -->
    <style name="Theme.Signal" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
