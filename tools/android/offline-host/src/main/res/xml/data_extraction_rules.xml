<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: the WebView's stored history, favourites, projects and settings go to backup and to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
