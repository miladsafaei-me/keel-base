# Copy to .env and fill. Read by podman compose (interpolation) and by Django
# (config/settings.py, via python-dotenv). Never commit the real .env.

# --- stack identity (Bucket-3 blanks) ---
# Keep PROJECT_SLUG == the compose `name:` in compose.yaml / compose.prod.yaml so
# the network + volumes the deploy references resolve.
COMPOSE_PROJECT_NAME=keel
PROJECT_SLUG=keel

# --- host ports (chosen high to avoid clashing with other local stacks) ---
DB_PORT=5432
REDIS_PORT=6379
WEB_PORT=8000
NGINX_PORT=8080
ADMINER_PORT=8005

# --- database ---
POSTGRES_DB=keel
POSTGRES_USER=keel
POSTGRES_PASSWORD=keel

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_BEHIND_PROXY=1
# Local dev: gunicorn auto-reloads on .py changes via the bind-mount. Unset on prod.
GUNICORN_RELOAD=1
