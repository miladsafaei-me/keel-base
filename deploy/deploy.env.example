# Copy to deploy/deploy.env and fill for your fork. Sourced by prod-deploy.sh and
# interpolated into compose.prod.yaml. No secrets belong here (those live in .env).

# Compose project name / container-name prefix. MUST equal `name:` in the compose
# files so the network (${PROJECT_SLUG}_default) and volumes (${PROJECT_SLUG}_media)
# that prod-deploy.sh references resolve.
PROJECT_SLUG=keel

# The built image the deploy pulls + boots (built by .github/workflows/build-image.yml).
IMAGE_REF=ghcr.io/OWNER/keel-web:latest

# Canonical public host — used as the Host header in the canary/prod smoke tests so
# ALLOWED_HOSTS passes.
PROD_HOST=example.com

# Optional: system nginx vhost sync during deploy. Leave unset to skip.
# NGINX_CONF_SRC=deploy/nginx/site.conf
# NGINX_CONF_DST=/etc/nginx/conf.d/site.conf
